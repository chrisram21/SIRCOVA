PORT=3000
MYSQL_HOST=
MYSQL_PORT=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=vacunacion_ddriss
MYSQL_SSL_CA=./certs/ca.pem
MONGO_URI=
MONGO_DB=vacunacion_config
JWT_SECRET=
JWT_EXPIRACION=2h
# Jornada (desde el inicio de sesión, aunque se renueve el JWT) e inactividad de la sesión: número + s, m o h
SESION_DURACION_MAXIMA=8h
SESION_INACTIVIDAD=30m
CORS_ORIGEN=http://localhost:5173

# Clave del HMAC del CUI (al menos 32 caracteres). La misma para todo el equipo; la comparte Luis por un medio seguro.
# Se generó una vez con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# No se cambia salvo que se filtre: con otra clave, los CUI guardados ya no coinciden.
CUI_HMAC_CLAVE=

# Solo para npm test: usuario de prueba creado con npm run crear-usuario (rol ADMINISTRADOR, DDRISS_SM)
PRUEBA_USUARIO=
PRUEBA_CONTRASENA=
