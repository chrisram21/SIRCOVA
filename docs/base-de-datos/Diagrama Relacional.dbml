// Plataforma web de producción de vacunación — DDRISS San Marcos (MSPAS)
// Modelo relacional preliminar v0.5 (MySQL 8.0) en formato DBML para dbdiagram.io
// Generado a partir de 01_modelo_relacional_mysql.sql. Las vistas y los datos
// semilla no se representan en DBML; están en el script SQL.
// Los grupos de tablas siguen los cuatro grupos de MySQL de la propuesta v2.

Project vacunacion_ddriss {
  database_type: 'MySQL'
  Note: '''
    Solo datos agregados: ninguna tabla guarda datos personales ni clínicos de pacientes.
    Las columnas esquema_mongo_id, regla_codigo, indicador_codigo y
    detalle_dimension.dimension_codigo / valor_codigo apuntan a documentos de
    MongoDB (vacunacion_config); no son llaves foráneas y las valida el backend.
  '''
}

Enum "cierre_periodo_estado_enum" {
  "ABIERTO"
  "EN_CIERRE"
  "CERRADO"
}

Enum "resultado_validacion_severidad_enum" {
  "ERROR"
  "ADVERTENCIA"
}

Enum "resultado_validacion_estado_enum" {
  "ABIERTO"
  "CORREGIDO"
  "JUSTIFICADO"
}

Enum "solicitud_rectificacion_estado_enum" {
  "PENDIENTE"
  "AUTORIZADA"
  "RECHAZADA"
  "APLICADA"
}

Enum "corrida_calculo_motivo_enum" {
  "CIERRE_PERIODO"
  "RECTIFICACION"
  "MANUAL"
  "PROGRAMADA"
}

Enum "corrida_calculo_estado_enum" {
  "EN_PROCESO"
  "COMPLETADA"
  "FALLIDA"
}

Enum "alerta_tipo_enum" {
  "REPORTE_PENDIENTE"
  "CALIDAD"
  "COBERTURA_BAJO_META"
  "PROCESO"
}

Enum "alerta_severidad_enum" {
  "INFO"
  "ADVERTENCIA"
  "CRITICA"
}

Enum "alerta_estado_enum" {
  "ACTIVA"
  "ATENDIDA"
  "DESCARTADA"
}

Enum "bitacora_modulo_enum" {
  "USUARIOS"
  "CONFIGURACION"
  "PRODUCCION"
  "REVISION"
  "RECTIFICACION"
  "INDICADORES"
  "REPORTES"
  "SISTEMA"
}

Table "rol" {
  "id" TINYINT [pk, not null, increment]
  "codigo" VARCHAR(30) [not null]
  "nombre" VARCHAR(80) [not null]
  "descripcion" VARCHAR(255)

  Indexes {
    codigo [unique, name: "uq_rol_codigo"]
  }
  Note: 'Roles del sistema (sección 5.3)'
}

Table "permiso" {
  "id" SMALLINT [pk, not null, increment]
  "codigo" VARCHAR(60) [not null, note: 'Ej.: PRODUCCION_REGISTRAR, REPORTE_APROBAR']
  "modulo" VARCHAR(40) [not null, note: 'Uno de los ocho módulos']
  "descripcion" VARCHAR(255)

  Indexes {
    codigo [unique, name: "uq_permiso_codigo"]
  }
}

Table "rol_permiso" {
  "rol_id" TINYINT [not null]
  "permiso_id" SMALLINT [not null]

  Indexes {
    (rol_id, permiso_id) [pk]
  }
}

Table "departamento" {
  "id" TINYINT [pk, not null, increment]
  "codigo_ine" CHAR(2) [not null, note: 'Código INE; 12 = San Marcos; 99 = no especificado']
  "nombre" VARCHAR(60) [not null]

  Indexes {
    codigo_ine [unique, name: "uq_departamento_codigo"]
  }
}

Table "municipio" {
  "id" SMALLINT [pk, not null, increment]
  "departamento_id" TINYINT [not null]
  "codigo_ine" CHAR(4) [not null, note: 'Código INE de 4 dígitos; también es la llave del GeoJSON']
  "nombre" VARCHAR(80) [not null]
  "activo" BOOLEAN [not null, default: TRUE]

  Indexes {
    codigo_ine [unique, name: "uq_municipio_codigo"]
    departamento_id [name: "ix_municipio_depto"]
  }
  Note: 'Catálogo INE; incluye municipios fuera de la DDRISS para registrar la procedencia'
}

Table "ddriss" {
  "id" TINYINT [pk, not null, increment]
  "codigo" VARCHAR(20) [not null, note: 'Código provisional, p. ej. DDRISS_SM']
  "nombre" VARCHAR(100) [not null]
  "departamento_id" TINYINT [not null, note: 'Departamento sede; un departamento puede tener más de una DDRISS']
  "activo" BOOLEAN [not null, default: TRUE]

  Indexes {
    codigo [unique, name: "uq_ddriss_codigo"]
    departamento_id [name: "ix_ddriss_depto"]
  }
}

Table "distrito_salud" {
  "id" SMALLINT [pk, not null, increment]
  "ddriss_id" TINYINT [not null, note: 'DDRISS a la que pertenece el distrito']
  "municipio_id" SMALLINT [not null]
  "codigo" VARCHAR(20) [not null]
  "nombre" VARCHAR(120) [not null]
  "activo" BOOLEAN [not null, default: TRUE]

  Indexes {
    codigo [unique, name: "uq_distrito_codigo"]
    ddriss_id [name: "ix_distrito_ddriss"]
  }
}

Table "tipo_establecimiento" {
  "id" TINYINT [pk, not null, increment]
  "codigo" VARCHAR(20) [not null]
  "nombre" VARCHAR(80) [not null]

  Indexes {
    codigo [unique, name: "uq_tipoest_codigo"]
  }
}

Table "establecimiento" {
  "id" INT [pk, not null, increment]
  "codigo" VARCHAR(20) [not null, note: 'Código institucional (p. ej. el usado en SIGSA)']
  "nombre" VARCHAR(150) [not null]
  "tipo_establecimiento_id" TINYINT [not null]
  "ddriss_id" TINYINT [not null, note: 'DDRISS a la que reporta; coincide con la de su distrito salvo en los externos']
  "distrito_salud_id" SMALLINT [note: 'NULL solo para establecimientos externos a la DDRISS']
  "municipio_id" SMALLINT [not null, note: 'Municipio de aplicación de sus dosis']
  "reporta_produccion" BOOLEAN [not null, default: TRUE, note: 'FALSE si su producción la consolida otro establecimiento']
  "es_externo" BOOLEAN [not null, default: FALSE, note: 'TRUE: su municipio no pertenece al territorio de la DDRISS a la que reporta (p. ej. Coatepeque); lo valida el backend']
  "direccion" VARCHAR(255) [note: 'Dirección física (aldea, cantón, zona, calle); el municipio va en municipio_id']
  "telefono" VARCHAR(20)
  "correo" VARCHAR(150) [note: 'Correo institucional del establecimiento']
  "nombre_contacto" VARCHAR(150) [note: 'Persona de contacto o encargado del establecimiento']
  "activo" BOOLEAN [not null, default: TRUE]
  "creado_en" DATETIME [not null, default: `CURRENT_TIMESTAMP`]
  "actualizado_en" DATETIME [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    codigo [unique, name: "uq_establecimiento_codigo"]
    municipio_id [name: "ix_establecimiento_municipio"]
    ddriss_id [name: "ix_establecimiento_ddriss"]
  }
}

Table "empleado" {
  "id" INT [pk, not null, increment]
  "codigo_empleado" VARCHAR(20) [note: 'Código o número de personal del MSPAS, si se usa']
  "nombres" VARCHAR(100) [not null]
  "apellidos" VARCHAR(100) [not null]
  "cargo" VARCHAR(100) [note: 'Ej.: enfermera auxiliar, estadígrafa, epidemióloga']
  "correo" VARCHAR(150) [note: 'Correo de contacto; se usa para notificaciones y recuperación de contraseña']
  "telefono" VARCHAR(20)
  "establecimiento_id" INT [note: 'Lugar de trabajo; obligatorio para personal de establecimiento']
  "ddriss_id" TINYINT [note: 'DDRISS donde trabaja; NULL solo para el rol AUTORIDAD de nivel nacional (lo valida el backend)']
  "municipio_id" SMALLINT [note: 'Alcance territorial opcional (p. ej. coordinador municipal)']
  "activo" BOOLEAN [not null, default: TRUE]
  "creado_en" DATETIME [not null, default: `CURRENT_TIMESTAMP`]
  "actualizado_en" DATETIME [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    codigo_empleado [unique, name: "uq_empleado_codigo"]
    correo [unique, name: "uq_empleado_correo"]
    establecimiento_id [name: "ix_empleado_est"]
    ddriss_id [name: "ix_empleado_ddriss"]
  }
  Note: 'Personal de la DDRISS y de los establecimientos; no son pacientes'
}

Table "usuario" {
  "id" INT [pk, not null, increment]
  "empleado_id" INT [not null]
  "nombre_usuario" VARCHAR(50) [not null]
  "hash_contrasena" VARCHAR(255) [not null, note: 'bcrypt/argon2; nunca la contraseña en claro']
  "rol_id" TINYINT [not null]
  "activo" BOOLEAN [not null, default: TRUE, note: 'Desactivación lógica de la cuenta (módulo 1)']
  "intentos_fallidos" TINYINT [not null, default: 0]
  "bloqueado_hasta" DATETIME
  "debe_cambiar_contrasena" BOOLEAN [not null, default: TRUE]
  "ultimo_acceso" DATETIME
  "creado_por" INT
  "creado_en" DATETIME [not null, default: `CURRENT_TIMESTAMP`]
  "actualizado_en" DATETIME [not null, default: `CURRENT_TIMESTAMP`]
  "desactivado_en" DATETIME

  Indexes {
    empleado_id [unique, name: "uq_usuario_empleado"]
    nombre_usuario [unique, name: "uq_usuario_usuario"]
    rol_id [name: "ix_usuario_rol"]
  }
  Note: 'Cuentas de acceso del personal'
}

Table "vacuna" {
  "id" SMALLINT [pk, not null, increment]
  "codigo" VARCHAR(20) [not null, note: 'Llave estable compartida con MongoDB (p. ej. PENTA)']
  "nombre" VARCHAR(120) [not null]
  "descripcion" VARCHAR(255)
  "orden_informe" SMALLINT [not null, default: 0]
  "activa" BOOLEAN [not null, default: TRUE]
  "creado_en" DATETIME [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    codigo [unique, name: "uq_vacuna_codigo"]
  }
}

Table "dosis" {
  "id" SMALLINT [pk, not null, increment]
  "vacuna_id" SMALLINT [not null]
  "codigo" VARCHAR(20) [not null, note: 'Ej.: D1, D2, D3, R1, R2, UNICA']
  "nombre" VARCHAR(60) [not null]
  "orden" TINYINT [not null, note: 'Secuencia en el esquema; base de la deserción entre dosis']
  "activa" BOOLEAN [not null, default: TRUE]

  Indexes {
    (vacuna_id, codigo) [unique, name: "uq_dosis_vacuna_codigo"]
  }
}

Table "clasificacion_poblacion" {
  "id" SMALLINT [pk, not null, increment]
  "codigo" VARCHAR(30) [not null, note: 'Ej.: MENOR_1, UN_ANIO, EMBARAZADAS, NINAS_10']
  "descripcion" VARCHAR(120) [not null]

  Indexes {
    codigo [unique, name: "uq_clasif_pob_codigo"]
  }
  Note: 'Clasificación del denominador de cobertura'
}

Table "poblacion_objetivo" {
  "id" INT [pk, not null, increment]
  "municipio_id" SMALLINT [not null]
  "anio" SMALLINT [not null]
  "vacuna_id" SMALLINT [not null]
  "clasificacion_poblacion_id" SMALLINT [not null]
  "cantidad" INT [not null]
  "fuente" VARCHAR(150) [note: 'Ej.: proyección INE / Unidad de Vacunación']
  "registrado_por" INT [not null]
  "creado_en" DATETIME [not null, default: `CURRENT_TIMESTAMP`]
  "actualizado_en" DATETIME [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    (municipio_id, anio, vacuna_id, clasificacion_poblacion_id) [unique, name: "uq_pobobj"]
  }
  Note: 'Denominadores de cobertura por municipio, año, vacuna y clasificación'
}

Table "periodo" {
  "id" SMALLINT [pk, not null, increment]
  "anio" SMALLINT [not null]
  "mes" TINYINT [not null]
  "fecha_inicio" DATE [not null]
  "fecha_fin" DATE [not null]

  Checks {
    `mes BETWEEN 1 AND 12` [name: 'ck_periodo_mes']
  }

  Indexes {
    (anio, mes) [unique, name: "uq_periodo"]
  }
  Note: 'Calendario común de periodos mensuales; el estado de cada mes va por DDRISS en cierre_periodo'
}

Table "cierre_periodo" {
  "id" INT [pk, not null, increment]
  "periodo_id" SMALLINT [not null]
  "ddriss_id" TINYINT [not null]
  "fecha_limite_envio" DATE [not null, note: 'Base de las alertas de reportes pendientes de esa DDRISS']
  "estado" cierre_periodo_estado_enum [not null, default: 'ABIERTO']
  "cerrado_por" INT
  "cerrado_en" DATETIME

  Checks {
    `estado <> 'CERRADO' OR (cerrado_por IS NOT NULL AND cerrado_en IS NOT NULL)` [name: 'ck_cierre_cerrado']
  }

  Indexes {
    (periodo_id, ddriss_id) [unique, name: "uq_cierre_periodo_ddriss"]
    (ddriss_id, estado) [name: "ix_cierre_ddriss_estado"]
  }
  Note: 'Apertura y cierre de cada periodo mensual por DDRISS'
}

Table "estado_reporte" {
  "codigo" VARCHAR(25) [pk, not null]
  "nombre" VARCHAR(40) [not null]
  "permite_edicion" BOOLEAN [not null, note: 'TRUE solo en BORRADOR y RECTIFICACION (esta última vía solicitud autorizada)']
  "orden" TINYINT [not null]
}

Table "transicion_estado" {
  "estado_origen" VARCHAR(25) [not null]
  "estado_destino" VARCHAR(25) [not null]
  "rol_id" TINYINT [not null]
  "requiere_comentario" BOOLEAN [not null, default: FALSE]

  Indexes {
    (estado_origen, estado_destino, rol_id) [pk]
  }
}

Table "reporte_produccion" {
  "id" INT [pk, not null, increment]
  "establecimiento_id" INT [not null]
  "periodo_id" SMALLINT [not null]
  "estado" VARCHAR(25) [not null, default: 'BORRADOR']
  "numero_rectificacion" TINYINT [not null, default: 0, note: 'Se incrementa con cada rectificación aplicada']
  "observaciones" VARCHAR(500)
  "creado_por" INT [not null]
  "creado_en" DATETIME [not null, default: `CURRENT_TIMESTAMP`]
  "actualizado_en" DATETIME [not null, default: `CURRENT_TIMESTAMP`]
  "enviado_en" DATETIME
  "revisor_id" INT [note: 'Revisor asignado en la transición Enviado -> En revisión']
  "asignado_en" DATETIME
  "aprobado_por" INT
  "aprobado_en" DATETIME
  "cerrado_en" DATETIME
  "version_fila" INT [not null, default: 1, note: 'Control de concurrencia optimista']

  Indexes {
    (establecimiento_id, periodo_id) [unique, name: "uq_reporte_est_periodo"]
    (periodo_id, estado) [name: "ix_reporte_periodo_estado"]
  }
}

Table "reporte_vacuna" {
  "id" INT [pk, not null, increment]
  "reporte_id" INT [not null]
  "vacuna_id" SMALLINT [not null]
  "esquema_mongo_id" CHAR(24) [not null, note: 'ObjectId del documento en esquemas_captura']
  "esquema_version" SMALLINT [not null, note: 'Copia de la versión para consultas sin ir a MongoDB']
  "datos_adicionales" JSON [note: 'Valores de campos no dimensionales definidos por el esquema (siempre agregados)']
  "total_declarado" INT [note: 'Total de dosis declarado por el establecimiento; se contrasta con la suma del detalle']

  Indexes {
    (reporte_id, vacuna_id) [unique, name: "uq_repvac"]
    esquema_mongo_id [name: "ix_repvac_esquema"]
  }
}

Table "detalle_produccion" {
  "id" BIGINT [pk, not null, increment]
  "reporte_vacuna_id" INT [not null]
  "dosis_id" SMALLINT [not null]
  "municipio_procedencia_id" SMALLINT [not null, note: 'Usar el registro 9999 si la procedencia no se conoce']
  "clave_combinacion" VARCHAR(255) [not null, default: '', note: 'Forma canónica de las dimensiones, ordenadas por código: grupo_edad=MENOR_1|sexo=F. Vacía si la vacuna no desagrega']
  "cantidad" INT [not null, default: 0]
  "actualizado_por" INT [not null]
  "actualizado_en" DATETIME [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    (reporte_vacuna_id, dosis_id, municipio_procedencia_id, clave_combinacion) [unique, name: "uq_detalle"]
    (municipio_procedencia_id, dosis_id) [name: "ix_detalle_procedencia"]
  }
  Note: 'Producción agregada; sin datos de pacientes'
}

Table "detalle_dimension" {
  "detalle_id" BIGINT [not null]
  "dimension_codigo" VARCHAR(30) [not null, note: 'catalogo_dimensiones.codigo']
  "valor_codigo" VARCHAR(30) [not null, note: 'catalogo_dimensiones.valores.codigo']

  Indexes {
    (detalle_id, dimension_codigo) [pk]
    (dimension_codigo, valor_codigo, detalle_id) [name: "ix_dimension_valor"]
  }
  Note: 'Desagregación dinámica por vacuna (modelo entidad-atributo-valor acotado)'
}

Table "historial_estado_reporte" {
  "id" BIGINT [pk, not null, increment]
  "reporte_id" INT [not null]
  "estado_anterior" VARCHAR(25)
  "estado_nuevo" VARCHAR(25) [not null]
  "usuario_id" INT [not null]
  "comentario" VARCHAR(1000)
  "fecha" DATETIME [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    (reporte_id, fecha) [name: "ix_hist_reporte"]
  }
}

Table "observacion_revision" {
  "id" BIGINT [pk, not null, increment]
  "reporte_id" INT [not null]
  "reporte_vacuna_id" INT [note: 'NULL = observación general del reporte']
  "detalle_id" BIGINT [note: 'Celda puntual observada, si aplica']
  "usuario_id" INT [not null]
  "texto" VARCHAR(1000) [not null]
  "atendida" BOOLEAN [not null, default: FALSE]
  "atendida_en" DATETIME
  "creado_en" DATETIME [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    reporte_id [name: "ix_obs_reporte"]
  }
}

Table "resultado_validacion" {
  "id" BIGINT [pk, not null, increment]
  "reporte_id" INT [not null]
  "reporte_vacuna_id" INT
  "detalle_id" BIGINT
  "regla_codigo" VARCHAR(40) [not null, note: 'Código de la regla en reglas_validacion']
  "regla_version" SMALLINT [not null]
  "severidad" resultado_validacion_severidad_enum [not null, note: 'ERROR bloquea el envío']
  "mensaje" VARCHAR(500) [not null]
  "estado" resultado_validacion_estado_enum [not null, default: 'ABIERTO']
  "justificacion" VARCHAR(500) [note: 'Solo para advertencias']
  "ejecutado_en" DATETIME [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    (reporte_id, severidad, estado) [name: "ix_val_reporte"]
  }
}

Table "solicitud_rectificacion" {
  "id" INT [pk, not null, increment]
  "reporte_id" INT [not null]
  "solicitado_por" INT [not null]
  "motivo" VARCHAR(1000) [not null]
  "evidencia_ruta" VARCHAR(255) [note: 'Documento de respaldo (oficio, acta); nunca datos de pacientes']
  "estado" solicitud_rectificacion_estado_enum [not null, default: 'PENDIENTE']
  "resuelto_por" INT
  "comentario_resolucion" VARCHAR(500)
  "solicitado_en" DATETIME [not null, default: `CURRENT_TIMESTAMP`]
  "resuelto_en" DATETIME
  "aplicado_en" DATETIME

  Indexes {
    (reporte_id, estado) [name: "ix_rect_reporte"]
  }
}

Table "rectificacion_detalle" {
  "id" BIGINT [pk, not null, increment]
  "solicitud_id" INT [not null]
  "detalle_id" BIGINT [note: 'NULL si la rectificación agrega una combinación nueva']
  "reporte_vacuna_id" INT [not null]
  "dosis_id" SMALLINT [not null]
  "municipio_procedencia_id" SMALLINT [not null]
  "clave_combinacion" VARCHAR(255) [not null, default: '', note: 'Identifica la celda aunque detalle_id se haya creado en la rectificación']
  "cantidad_anterior" INT [not null]
  "cantidad_nueva" INT [not null]
}

Table "corrida_calculo" {
  "id" INT [pk, not null, increment]
  "anio" SMALLINT [not null]
  "mes_hasta" TINYINT [not null, note: 'Mes de corte del cálculo acumulado']
  "disparada_por" INT [note: 'NULL = proceso automático (p. ej. al cerrar periodo)']
  "motivo" corrida_calculo_motivo_enum [not null]
  "estado" corrida_calculo_estado_enum [not null, default: 'EN_PROCESO']
  "iniciada_en" DATETIME [not null, default: `CURRENT_TIMESTAMP`]
  "finalizada_en" DATETIME
  "vigente" BOOLEAN [not null, default: FALSE, note: 'Solo una corrida vigente por (anio, mes_hasta)']

  Indexes {
    (anio, mes_hasta, vigente) [name: "ix_corrida_vigente"]
  }
  Note: 'Cada ejecución del motor de indicadores'
}

Table "resultado_indicador" {
  "id" BIGINT [pk, not null, increment]
  "corrida_id" INT [not null]
  "indicador_codigo" VARCHAR(40) [not null, note: 'Código en configuracion_indicadores']
  "indicador_version" SMALLINT [not null]
  "municipio_id" SMALLINT [note: 'NULL = nivel departamental']
  "vacuna_id" SMALLINT [not null]
  "dosis_id" SMALLINT [note: 'Dosis evaluada (o dosis final en deserción)']
  "filtro_dimensiones" VARCHAR(255) [not null, default: '', note: 'Filtro aplicado, en la misma forma canónica (grupo_edad=MENOR_1)']
  "anio" SMALLINT [not null]
  "mes" TINYINT [not null, note: 'Mes de corte']
  "es_proyeccion" BOOLEAN [not null, default: FALSE, note: 'TRUE = estimación; se muestra diferenciada del dato real']
  "numerador" DECIMAL(14,2)
  "denominador" DECIMAL(14,2)
  "valor" DECIMAL(9,4) [note: 'Porcentaje o tasa según el indicador']
  "meta" DECIMAL(9,4)
  "brecha_dosis" INT [note: 'Dosis aproximadas faltantes para la meta']
  "cumple_meta" BOOLEAN
  "calculado_en" DATETIME [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    (corrida_id, indicador_codigo, municipio_id, vacuna_id, dosis_id, filtro_dimensiones, anio, mes, es_proyeccion) [unique, name: "uq_resultado"]
    (indicador_codigo, anio, mes, vacuna_id, municipio_id) [name: "ix_resultado_consulta"]
  }
}

Table "alerta" {
  "id" BIGINT [pk, not null, increment]
  "tipo" alerta_tipo_enum [not null]
  "severidad" alerta_severidad_enum [not null, default: 'ADVERTENCIA']
  "titulo" VARCHAR(150) [not null]
  "mensaje" VARCHAR(1000) [not null]
  "ddriss_id" TINYINT [note: 'DDRISS a cuya bandeja pertenece; NULL = alerta de nivel nacional']
  "periodo_id" SMALLINT
  "municipio_id" SMALLINT
  "establecimiento_id" INT
  "reporte_id" INT
  "resultado_indicador_id" BIGINT
  "rol_destino_id" TINYINT [note: 'Rol que debe ver la alerta']
  "estado" alerta_estado_enum [not null, default: 'ACTIVA']
  "atendida_por" INT
  "atendida_en" DATETIME
  "generada_en" DATETIME [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    (estado, tipo, generada_en) [name: "ix_alerta_estado"]
    (ddriss_id, estado) [name: "ix_alerta_ddriss"]
  }
}

Table "bitacora" {
  "id" BIGINT [pk, not null, increment]
  "fecha" DATETIME(3) [not null, default: `CURRENT_TIMESTAMP(3)`]
  "usuario_id" INT [note: 'NULL en intentos de acceso fallidos o procesos automáticos']
  "nombre_usuario_intento" VARCHAR(50) [note: 'Usuario tecleado en un inicio de sesión fallido']
  "modulo" bitacora_modulo_enum [not null]
  "accion" VARCHAR(40) [not null, note: 'Ej.: LOGIN_OK, LOGIN_FALLIDO, CREAR, ACTUALIZAR, DESACTIVAR, CAMBIO_ESTADO, PUBLICAR_ESQUEMA']
  "entidad" VARCHAR(60) [not null, note: 'Tabla MySQL o colección MongoDB afectada']
  "entidad_id" VARCHAR(40) [note: 'Id numérico de MySQL u ObjectId de MongoDB']
  "valores_anteriores" JSON
  "valores_nuevos" JSON
  "ip_origen" VARCHAR(45)
  "agente_usuario" VARCHAR(255)

  Indexes {
    fecha [name: "ix_bitacora_fecha"]
    (usuario_id, fecha) [name: "ix_bitacora_usuario"]
    (entidad, entidad_id) [name: "ix_bitacora_entidad"]
    (modulo, accion, fecha) [name: "ix_bitacora_modulo"]
  }
  Note: 'Solo INSERT; el usuario de la aplicación no tiene UPDATE/DELETE sobre esta tabla'
}

